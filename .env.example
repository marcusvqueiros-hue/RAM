# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # (ou NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # SOMENTE servidor — nunca expor no cliente

# Código que os técnicos informam em /cadastrar (escolha um valor difícil de adivinhar)
TEAM_SIGNUP_CODE=troque-este-codigo

# Protege /api/cron/metas (a Vercel envia como Bearer automaticamente)
CRON_SECRET=gere-um-valor-aleatorio
